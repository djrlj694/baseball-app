# Ignore Python cache and build files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore virtual environments
venv/
.env/

# Ignore git and Docker files
.git
.gitignore
.dockerignore

# Ignore editor and OS files
*.swp
.DS_Store

# Ignore test and coverage files
.coverage
htmlcov/

# Ignore Alembic migration files (if not needed in image)
alembic/

# Ignore other unnecessary files
*.log
